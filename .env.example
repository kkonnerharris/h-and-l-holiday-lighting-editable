# Static hosting: these values are public and embedded at build time.
# Published HTTPS website hosting public/images (also used when testing locally).
NEXT_PUBLIC_SITE_URL=
# Optional form storage endpoint from google-apps-script.gs
NEXT_PUBLIC_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/your-script-id/exec
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
NEXT_PUBLIC_NOTIFICATION_EMAIL=your-email@example.com
